# ASAGUITUR · variables de entorno
# Local: copia este archivo como ".env". En producción se cargan en Netlify (Site configuration → Environment variables).

# ---------- Supabase (Project Settings → API) ----------
PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
# SECRETA. Solo servidor. Nunca con prefijo PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# ---------- Sitio ----------
# URL pública final, sin barra al final. Se usa en el QR del carné, en los enlaces de pago y en los correos.
PUBLIC_SITE_URL=https://www.asaguitur.org

# ---------- Wompi El Salvador (panel.wompi.sv → tu Aplicativo) ----------
WOMPI_CLIENT_ID=
WOMPI_CLIENT_SECRET=
# true solo mientras pruebas con el aplicativo en modo desarrollo. En producción, BORRAR esta variable.
WOMPI_PERMITIR_PRUEBAS=true

# ---------- Cuota de membresía (la define la Junta) ----------
CUOTA_MONTO_USD=25
CUOTA_MESES=12

# ---------- Resend (resend.com → API Keys) ----------
RESEND_API_KEY=
RESEND_FROM=ASAGUITUR <comunicaciones@asaguitur.org>
RESEND_REPLY_TO=
